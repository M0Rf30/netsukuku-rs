config netsukuku-rs 'main'
	# Installing this package must never start a daemon that reprograms the router's routing
	# table without an explicit opt-in — leave this '0' until every option below is reviewed.
	option enabled '0'

	# Names of the network interfaces to monitor for mesh neighbours (NtkdConfig::nics).
	# Repeat for every interface ntkd should use.
	list nics 'eth0'

	# Per-level g-node sizes, index 0 innermost (NtkdConfig::gsizes). Must describe a valid
	# ntk_common::Topology — non-empty, no zero-sized level. The sample below (2, 1, 1, 1)
	# matches the values used throughout upstream's own test suite.
	list gsizes '2'
	list gsizes '1'
	list gsizes '1'
	list gsizes '1'

	# TCP/UDP port every ntk-rpc transport binds to (NtkdConfig::port). 269 is the port used
	# throughout this project's own test suite and docs.
	option port '269'

	# Path to this node's persisted ANDNA ed25519 signing-key seed (NtkdConfig::andna_key_path).
	# Leave unset to refuse ANDNA hostname registration outright rather than silently disabling
	# it. Uncomment and point at a path on persistent storage to enable it.
	# option andna_key_path '/etc/ntkd/andna.key'

	# Path to this node's persisted RPC-identity ed25519 signing-key seed
	# (NtkdConfig::node_key_path), used to sign outbound RPCs. Deliberately a different key
	# from andna_key_path (see that field's own doc in kernel/config.rs). Required if
	# require_auth is enabled below.
	# option node_key_path '/etc/ntkd/node.key'

	# Reject inbound RPCs lacking a valid ntk_proto::auth block (NtkdConfig::require_auth).
	# Defaults to '0': the only setting interoperable with an unmodified upstream Vala node.
	# Requires node_key_path to be set when enabled to '1'.
	option require_auth '0'

	# Log verbosity passed to `ntkd run --log-level`: error, warn, info, debug, or trace.
	option log_level 'info'
